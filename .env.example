# Copy to `.env` (or just export these) to configure Forge's model provider.
# Forge honors the standard ANTHROPIC_* variables so an existing
# Anthropic-compatible gateway works with no extra configuration.

# Base URL of the Anthropic-compatible API (optional; defaults to Anthropic).
ANTHROPIC_BASE_URL=https://api.anthropic.com

# Credentials: use a bearer token (gateways) OR an API key.
ANTHROPIC_AUTH_TOKEN=
# ANTHROPIC_API_KEY=

# Model id to use.
ANTHROPIC_MODEL=claude-sonnet-4-5

# --- Optional Forge overrides (take precedence over ANTHROPIC_*) ---
# FORGE_PROVIDER=anthropic
# FORGE_MODEL=
# FORGE_MAX_ITERATIONS=25
# FORGE_SHELL_TIMEOUT=120
# FORGE_AUTO_APPROVE=0
# FORGE_LOG_LEVEL=WARNING
# FORGE_LOG_JSON=0
